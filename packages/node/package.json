{
  "$schema": "https://json.schemastore.org/package",
  "name": "@render/node",
  "version": "0.1.0",
  "description": "The reactive node store of render: seats, slots, ordered flow epochs and the NodeOps extension points.",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./package.json": "./package.json"
  },
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.test.json"
  },
  "dependencies": {
    "@render/dsl": "workspace:*",
    "@render/optional": "workspace:*"
  },
  "devDependencies": {
    "@mark1russell7/cue": "github:mark1russell7/cue",
    "@types/node": "^26.6.4",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  }
}
