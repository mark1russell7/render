{
  "$schema": "https://json.schemastore.org/package",
  "name": "@render/site",
  "version": "0.1.0",
  "description": "The site of render: the guide, the live viewer and the review. GitHub Pages serves it.",
  "private": true,
  "type": "module",
  "scripts": {
    "gen": "node scripts/gen-docs.mjs",
    "report": "node scripts/test-report.mjs",
    "dev": "node scripts/gen-docs.mjs && astro dev",
    "build": "node scripts/gen-docs.mjs && astro build",
    "preview": "astro preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@astrojs/react": "^7.0.1",
    "@astrojs/starlight": "^0.42.6",
    "@fontsource-variable/atkinson-hyperlegible-mono": "^5.3.0",
    "@fontsource-variable/atkinson-hyperlegible-next": "^5.3.0",
    "@render/biblo": "workspace:*",
    "@render/dsl": "workspace:*",
    "@render/node": "workspace:*",
    "@render/optional": "workspace:*",
    "@render/splay": "workspace:*",
    "@render/viewer": "workspace:*",
    "astro": "^7.3.8",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@mark1russell7/cue": "github:mark1russell7/cue",
    "@playwright/test": "^1.64.0",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.3",
    "vitest": "^5.0.3"
  }
}
