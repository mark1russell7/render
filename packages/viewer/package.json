{
  "$schema": "https://json.schemastore.org/package",
  "name": "@mark1russell7/render-viewer",
  "version": "0.4.0",
  "description": "The React viewer of render: the type graph and the canvas.",
  "keywords": [
    "react",
    "live-programming",
    "visual-editor",
    "reactive",
    "type-graph",
    "undo",
    "typescript"
  ],
  "homepage": "https://mark1russell7.github.io/render/",
  "bugs": {
    "url": "https://github.com/mark1russell7/render/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mark1russell7/render.git",
    "directory": "packages/viewer"
  },
  "license": "MIT",
  "author": "Mark Russell (https://github.com/mark1russell7)",
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./styles.css": "./src/styles.css",
    "./package.json": "./package.json"
  },
  "files": [
    "build",
    "src",
    "!src/**/*.test.ts",
    "!src/**/*.test.tsx",
    "!src/main.tsx",
    "!src/page.css"
  ],
  "publishConfig": {
    "access": "public",
    "main": "./build/index.js",
    "types": "./build/index.d.ts",
    "exports": {
      ".": {
        "types": "./build/index.d.ts",
        "default": "./build/index.js"
      },
      "./styles.css": "./src/styles.css",
      "./package.json": "./package.json"
    }
  },
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "build": "tsdown",
    "dev": "vite",
    "build:app": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.test.json"
  },
  "peerDependencies": {
    "react": "^19.0.0"
  },
  "dependencies": {
    "@mark1russell7/coeval": "^0.7.0",
    "@mark1russell7/packing": "^0.1.1",
    "@mark1russell7/render-biblo": "workspace:*",
    "@mark1russell7/render-dsl": "workspace:*",
    "@mark1russell7/render-node": "workspace:*",
    "@mark1russell7/render-optional": "workspace:*",
    "@mark1russell7/render-splay": "workspace:*"
  },
  "devDependencies": {
    "@mark1russell7/cue": "github:mark1russell7/cue",
    "@playwright/test": "^1.64.0",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tsdown": "^0.23.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.3",
    "vitest": "^5.0.3"
  }
}
