{
  "$schema": "https://json.schemastore.org/package",
  "name": "@render/splay",
  "version": "0.1.0",
  "description": "The hydrate, splay and dehydrate engine of render, the standard classes and the standard ops.",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./package.json": "./package.json"
  },
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.test.json",
    "bench": "vitest bench --run -c vitest.bench.config.ts --reporter=verbose"
  },
  "dependencies": {
    "@render/biblo": "workspace:*",
    "@render/dsl": "workspace:*",
    "@render/node": "workspace:*",
    "@render/optional": "workspace:*"
  },
  "devDependencies": {
    "@mark1russell7/cue": "github:mark1russell7/cue",
    "@types/node": "^26.6.4",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  }
}
