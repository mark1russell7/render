{
  "$schema": "https://json.schemastore.org/package",
  "name": "@mark1russell7/render-biblo",
  "version": "0.2.1",
  "description": "The class registry and the instance store of render, and the class-level NodeOps.",
  "keywords": [
    "classes",
    "templates",
    "traits",
    "prototype",
    "reactive",
    "typescript"
  ],
  "homepage": "https://mark1russell7.github.io/render/",
  "bugs": {
    "url": "https://github.com/mark1russell7/render/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mark1russell7/render.git",
    "directory": "packages/biblo"
  },
  "license": "MIT",
  "author": "Mark Russell (https://github.com/mark1russell7)",
  "type": "module",
  "sideEffects": false,
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./package.json": "./package.json"
  },
  "files": [
    "build",
    "src",
    "!src/**/*.test.ts",
    "!src/**/*.test.tsx",
    "!src/main.tsx",
    "!src/page.css"
  ],
  "publishConfig": {
    "access": "public",
    "main": "./build/index.js",
    "types": "./build/index.d.ts",
    "exports": {
      ".": {
        "types": "./build/index.d.ts",
        "default": "./build/index.js"
      },
      "./package.json": "./package.json"
    }
  },
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "build": "tsdown",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.test.json"
  },
  "dependencies": {
    "@mark1russell7/coeval": "^0.4.3",
    "@mark1russell7/render-dsl": "workspace:*",
    "@mark1russell7/render-node": "workspace:*",
    "@mark1russell7/render-optional": "workspace:*"
  },
  "devDependencies": {
    "@mark1russell7/cue": "github:mark1russell7/cue",
    "@types/node": "^26.6.4",
    "tsdown": "^0.23.1",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  }
}
