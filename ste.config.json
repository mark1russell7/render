{
  "$schema": "./node_modules/@mark1russell7/ste-lint/ste.config.schema.json",
  "include": [
    "README.md",
    "CLAUDE.md",
    "docs/**/*.{md,mdx}",
    "packages/*/README.md",
    "packages/site/**/*.{md,mdx}",
    "packages/*/src/**/*.{ts,tsx}",
    "packages/*/bench/**/*.ts",
    "packages/*/*.config.{ts,mts}"
  ],
  "ignore": [
    "**/node_modules/**",
    "**/dist/**",
    "**/*.d.ts",
    "**/*.test.ts",
    "**/*.test.tsx",
    "**/*.spec.ts",
    "**/*.spec.tsx",
    "packages/cli/**"
  ],
  "technicalNouns": [],
  "technicalVerbs": [],
  "properNouns": [
    "ASD",
    "ASD-STE100",
    "Claude",
    "GitHub",
    "pnpm",
    "React",
    "Simplified Technical English",
    "TSDoc",
    "TypeScript",
    "Vite",
    "Vitest"
  ]
}
